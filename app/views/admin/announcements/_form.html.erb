<%= form_with model: [:admin, announcement], class: "admin-form" do |f| %>

  <% if announcement.errors.any? %>
    <div class="admin-errors">
      <ul>
        <% announcement.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="admin-form-field">
    <%= f.label :title, t("admin.title_uk"), class: "admin-label" %>
    <%= f.text_field :title, class: "admin-input" %>
  </div>

  <div class="admin-form-field">
    <%= f.label :title_en, t("admin.title_en"), class: "admin-label" %>
    <%= f.text_field :title_en, class: "admin-input" %>
  </div>

  <div class="admin-form-field">
    <%= f.label :poster, t("admin.poster"), class: "admin-label" %>
    <%= f.url_field :poster, class: "admin-input" %>
  </div>

  <div class="admin-form-field">
    <%= f.label :release_date, t("admin.release_date"), class: "admin-label" %>
    <%= f.text_field :release_date, class: "admin-input", placeholder: "з 21 травня 2026" %>
  </div>

  <div class="admin-form-field">
    <%= f.label :description, t("admin.description_uk"), class: "admin-label" %>
    <%= f.text_area :description, class: "admin-input admin-textarea", rows: 5 %>
  </div>

  <div class="admin-form-field">
    <%= f.label :description_en, t("admin.description_en"), class: "admin-label" %>
    <%= f.text_area :description_en, class: "admin-input admin-textarea", rows: 5 %>
  </div>

  <div class="admin-form-actions">
    <%= f.submit t("admin.save"), class: "admin-btn" %>
    <%= link_to t("admin.back"), admin_announcements_path, class: "admin-btn admin-btn-secondary" %>
  </div>

<% end %>
