<div class="admin-page">
  <div class="admin-card">
    <div class="admin-header">
      <h1><%= t("burger.admin") %>: <%= t("admin.promotions") %></h1>
    </div>

    <%= render "admin/shared/nav" %>

    <% if @promotions.any? %>
      <div class="admin-grid">
        <% @promotions.each do |promotion| %>
          <div class="admin-movie-card">
            <% if promotion.image.present? %>
              <img src="<%= promotion.image %>" alt="<%= promotion.title %>" class="admin-movie-poster">
            <% end %>

            <div class="admin-movie-info">
              <h2><%= promotion.title %></h2>
              <p><strong><%= t("admin.active") %>:</strong> <%= promotion.active? ? "✓" : "—" %></p>
              <p><%= promotion.description.to_s.truncate(120) %></p>

              <div class="admin-movie-actions">
                <%= link_to t("admin.edit_promotion"), edit_admin_promotion_path(promotion), class: "admin-btn admin-btn-secondary" %>
                <%= button_to t("admin.delete_promotion"),
                  admin_promotion_path(promotion),
                  method: :delete,
                  class: "admin-btn admin-danger-btn",
                  data: { turbo_confirm: "Видалити цю акцію?" } %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="admin-empty">Акцій ще немає</p>
    <% end %>
  </div>
</div>
