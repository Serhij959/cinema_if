<div class="admin-page">
  <div class="admin-card">
    <h1><%= t("admin.edit_user") %></h1>
    <p class="admin-user-email"><%= @user.email %></p>

    <%= render "admin/shared/nav" %>

    <%= form_with model: [:admin, @user], class: "admin-form" do |f| %>

      <% if @user.errors.any? %>
        <div class="admin-errors">
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="admin-form-field">
        <%= f.label :role, t("admin.role"), class: "admin-label" %>
        <%= f.select :role, @role_options, {}, class: "admin-input" %>
      </div>

      <div class="admin-form-actions">
        <%= f.submit t("admin.save"), class: "admin-btn" %>
        <%= link_to t("admin.back"), admin_users_path, class: "admin-btn admin-btn-secondary" %>
      </div>

    <% end %>
  </div>
</div>
