<div class="auth-page">

  <a href="/" class="back-home-btn">
    ← <%= t("back") %>
  </a>
  <div class="auth-language-switcher">

  <%= link_to "UA",
    url_for(locale: :uk),
    class: "lang #{'active' if I18n.locale == :uk}" %>

  <span>/</span>

  <%= link_to "EN",
    url_for(locale: :en),
    class: "lang #{'active' if I18n.locale == :en}" %>

  </div>

  <div class="auth-box">

    <div class="auth-logo">
      🎬
    </div>

    <h1 class="auth-title">
      CinemaIF
    </h1>

    <p class="auth-subtitle">
      <%= t("auth.login_title") %>
    </p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

      <div class="field">
        <%= f.email_field :email,
          autofocus: true,
          autocomplete: "email",
          placeholder: t("auth.email") %>
      </div>

      <div class="field">
        <%= f.password_field :password,
          autocomplete: "current-password",
          placeholder: t("auth.password") %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="remember">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, t("remember_me") %>
        </div>
      <% end %>

      <%= f.submit t("login"), class: "auth-btn" %>

    <% end %>

    <div class="auth-links">
      <%= link_to t("create_account"), new_registration_path(resource_name) %>

      <%= link_to t("forgot_password"), new_password_path(resource_name) %>
    </div>

  </div>

</div>