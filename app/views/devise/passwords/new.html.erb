<div class="auth-page">

  <div class="auth-box">

    <div class="auth-logo">
      🔒
    </div>

    <h1 class="auth-title">
      Reset password
    </h1>

    <p class="auth-subtitle">
      Enter your email to recover access
    </p>

    <%= form_for(resource,
      as: resource_name,
      url: password_path(resource_name),
      html: { method: :post }) do |f| %>

      <div class="field">
        <%= f.email_field :email,
          autofocus: true,
          autocomplete: "email",
          placeholder: "Email" %>
      </div>

      <%= f.submit "Send reset instructions",
        class: "auth-btn" %>

    <% end %>

    <div class="auth-links">

      <%= link_to "Log in",
        new_session_path(resource_name) %>

      <%= link_to "Create account",
        new_registration_path(resource_name) %>

    </div>

  </div>

</div>