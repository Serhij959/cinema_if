<div class="page">

  <section class="schedule-days" id="poster">

  <div class="dates">

    <% @days.first(5).each_with_index do |day, index| %>
      <button
        class="date-btn <%= 'active' if index == 0 %>"
        data-day="day-<%= index %>"
      >
        <strong><%= day[:date] %></strong>
        <span><%= day[:label] %></span>
      </button>
    <% end %>

    <div class="choose-date">
      <button class="choose-date-btn" id="chooseDateBtn">
        <strong><%= t("choose") rescue "Вибрати" %></strong>
        <span><%= t("day") rescue "день" %></span>
        <b>⌄</b>
      </button>

      <div class="date-dropdown" id="dateDropdown">
        <% @days.drop(5).each_with_index do |day, index| %>
           <% real_index = index + 5 %>

          <button
            class="dropdown-date-btn"
            data-day="day-<%= real_index %>"
          >
            <%= day[:date] %>
            <span><%= day[:label] %></span>
          </button>
        <% end %>
      </div>
    </div>

  </div>

 </section>

  <main class="content">

    <section class="cinema-schedule">

      <% @days.each_with_index do |day, index| %>

        <div
          class="cinema_inside_sch_date <%= 'active' if index == 0 %>"
          id="day-<%= index %>"
        >

          <% day[:movies].each do |movie| %>

            <div class="film">

              <img src="<%= movie[:poster] %>" alt="<%= movie[:title] %>" class="film-poster">

              <div class="info">

                <h2 class="film-title">
                  <%= movie[:title] %>
                </h2>

                <div class="sessions">

                  <% movie[:sessions].each do |session| %>

                    <%= link_to booking_path(
                     screening_id: session[:id],
                     movie: movie[:title],
                     time: session[:time],                 
                     format: session[:format],
                     hall: session[:hall]
                    ), class: "session-link" do %>

                      <div class="session-time">
                        <%= session[:time] %>
                      </div>

                       <div class="session-format">
                        <%= session[:format] %>
                     </div>
                   <% end %>
                  <% end %>
                 </div>

                <div class="film-details">
                  <p>
                    <%= movie[:genre] %>
                  </p>

                  <p>
                    <%= movie[:duration] %>
                    <%= movie[:age] %>
                  </p>
                </div>

              </div>

            </div>

          <% end %>

        </div>

      <% end %>

    </section>

  </main>
  <section class="announcements-section" id="announcements">

  <h2><%= t("announcements") %></h2>

  <div class="announcements-grid">
    <% @announcements.each do |announcement| %>
      <div class="announcement-card">
        <img src="<%= announcement[:poster] %>" alt="<%= announcement[:title] %>">

        <div class="announcement-info">
          <h3><%= announcement[:title] %></h3>
          <p><%= announcement[:release_date] %></p>
        </div>
      </div>
    <% end %>
  </div>

  </section>

 <section class="promotions-section" id="promotions">

  <h2><%= t("promotions") %></h2>

  <div class="promotions-grid">
    <% @promotions.each do |promotion| %>
      <div class="promotion-card">
        <img src="<%= promotion[:image] %>" alt="<%= promotion[:title] %>">

        <div class="promotion-info">
          <h3><%= promotion[:title] %></h3>
          <p><%= promotion[:description] %></p>
        </div>
      </div>
    <% end %>
  </div>

 </section>

</div>
 
<script>
  document.addEventListener("click", function(event) {
    const burgerMenu = document.getElementById("burgerMenu")

    // бургер відкрити
    if (event.target.closest("#openBurger")) {
      if (burgerMenu) {
        burgerMenu.classList.add("active")
      }
    }

    // бургер закрити
    if (
      event.target.closest("#closeBurger") ||
      event.target.closest("#burgerOverlay")
    ) {
      if (burgerMenu) {
        burgerMenu.classList.remove("active")
      }
    }

    // клік по пункту бургер-меню
    const burgerLink = event.target.closest(".burger-link")

    if (burgerLink) {
      if (burgerMenu) {
        burgerMenu.classList.remove("active")
      }

      const href = burgerLink.getAttribute("href")

      if (href && href.startsWith("#")) {
        event.preventDefault()

        const target = document.querySelector(href)

        if (target) {
          setTimeout(function() {
            target.scrollIntoView({
              behavior: "smooth",
              block: "start"
            })
          }, 50)
        }
      }
    }

    // дати
    const dateButton = event.target.closest(".date-btn, .dropdown-date-btn")

    if (dateButton) {
      document.querySelectorAll(".date-btn, .dropdown-date-btn").forEach(btn => {
        btn.classList.remove("active")
      })

      document.querySelectorAll(".cinema_inside_sch_date").forEach(day => {
        day.classList.remove("active")
      })

      dateButton.classList.add("active")

      const id = dateButton.dataset.day
      const targetDay = document.getElementById(id)

      if (targetDay) {
        targetDay.classList.add("active")
      }

      const dropdown = document.getElementById("dateDropdown")

      if (dropdown) {
        dropdown.classList.remove("show")
      }
    }

    // вибір дати
    if (event.target.closest("#chooseDateBtn")) {
      const dropdown = document.getElementById("dateDropdown")

      if (dropdown) {
        dropdown.classList.toggle("show")
      }
    }

    // лого вверх
    if (event.target.closest("#logoTop")) {
      event.preventDefault()

      window.scrollTo({
        top: 0,
        behavior: "smooth"
      })
    }
  })
</script>