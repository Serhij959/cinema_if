<header class="header">
  <%= render "shared/burger_menu" %>

  <div class="burger" id="openBurger">
    ☰
  </div>

  <%= link_to root_path(locale: I18n.locale), class: "logo", id: "logoTop" do %>
    CinemaIF
  <% end %>

  <div class="header-right">

    <div class="language-switcher">

      <%= link_to request.path.sub(/^\/en/, "/uk"),
        class: "lang #{'active' if I18n.locale == :uk}",
        data: { turbo: false } do %>
        UA
      <% end %>

      <span>/</span>

      <%= link_to request.path.sub(/^\/uk/, "/en"),
        class: "lang #{'active' if I18n.locale == :en}",
        data: { turbo: false } do %>
        EN
      <% end %>

    </div>

    <% if user_signed_in? %>

      <div class="header-user-email">
        <%= current_user.email %>
      </div>

      <%= button_to t("logout"),
        destroy_user_session_path,
        method: :delete,
        class: "login-btn" %>

    <% else %>

      <%= link_to t("login"),
        new_user_session_path,
        class: "login-btn" %>

    <% end %>

  </div>
</header>