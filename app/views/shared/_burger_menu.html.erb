<div class="burger-menu" id="burgerMenu">

  <div class="burger-overlay" id="burgerOverlay"></div>

  <div class="burger-sidebar">

    <div class="burger-header">

      <h2>CinemaIF</h2>

      <button class="close-burger" id="closeBurger">
        ✕
      </button>

    </div>

    <nav class="burger-nav">

      <%= link_to root_path(locale: I18n.locale, anchor: "poster"),
        class: "burger-link" do %>

        <%= t("burger.schedule") %>

      <% end %>

      <%= link_to root_path(locale: I18n.locale, anchor: "announcements"),
        class: "burger-link" do %>

        <%= t("burger.announcements") %>

      <% end %>

      <%= link_to root_path(locale: I18n.locale, anchor: "promotions"),
        class: "burger-link" do %>

        <%= t("burger.promotions") %>

      <% end %>

      <% if user_signed_in? %>

        <%= link_to my_tickets_path(locale: I18n.locale),
          class: "burger-link" do %>

          <%= t("burger.my_tickets") %>

        <% end %>

      <% end %>

      <% if admin_user? %>

        <%= link_to admin_root_path, class: "burger-link" do %>

          <%= t("burger.admin") %>

        <% end %>

      <% end %>

    </nav>

  </div>

</div>