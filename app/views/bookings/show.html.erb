<div class="booking-page">

  <div class="booking-layout">

    <section class="booking-left">

      <div class="screen">
        <span><%= t("booking.screen") %></span>
      </div>

      <div class="hall">

        <% @rows.each do |row| %>
          <div class="seat-row">

            <span class="row-number"><%= row %></span>

            <% (1..@seats_per_row).each do |seat| %>
              <% booked = @booked_seats.include?([row, seat]) %>

              <button
                type="button"
                class="seat <%= 'booked' if booked %>"
                data-price="<%= @price || 150 %>"
                data-row="<%= row %>"
                data-seat="<%= seat %>"
                <%= 'disabled' if booked %>
              >
                <% if booked %>
                  👤
                <% end %>
              </button>
            <% end %>

          </div>
        <% end %>

      </div>

    </section>

    <aside class="booking-right">

      <h1><%= @movie_title %></h1>

      <div class="booking-session-card">

        <div>
          <span class="session-label"><%= t("booking.format") %></span>
          <strong><%= @format.presence || "2D" %></strong>
        </div>

        <div>
          <span class="session-label"><%= t("booking.hall") %></span>
          <strong><%= @hall_name.to_s.gsub("Зал", t("booking.hall_value")) %></strong>
        </div>

        <div>
          <span class="session-label"><%= t("booking.time") %></span>
          <strong><%= @time %></strong>
        </div>

      </div>

      <% if @movie_info %>
        <div class="booking-movie-info">
          <img src="<%= @movie_info[:poster] %>" alt="<%= @movie_title %>">

          <div>
            <h2><%= @movie_title %></h2>
            <p><%= @movie_info[:description] %></p>
          </div>
        </div>
      <% end %>

      <div class="order-box">
        <h3><%= t("booking.order") %></h3>

        <div id="selectedSeatsList" class="selected-seats-list">
          <p class="empty-order"><%= t("booking.empty_order") %></p>
        </div>

        <div class="order-total">
          <span><%= t("booking.total") %></span>
          <strong><span id="totalPrice">0</span> <%= t("booking.currency") %></strong>
        </div>

        <button type="button" class="continue-btn" id="openCheckoutModal">
          <%= t("booking.continue") %>
        </button>
      </div>

      <div class="checkout-modal" id="checkoutModal">
        <div class="checkout-overlay" id="closeCheckoutModal"></div>

        <div class="checkout-box dark-checkout">
          <button type="button" class="checkout-close" id="checkoutCloseBtn">×</button>

          <h2>
            <%= @movie_title %>
            <span><%= @format %></span>
          </h2>

          <p class="checkout-session">
            <%= @time %> • <%= @hall_name.to_s.gsub("Зал", t("booking.hall_value")) %>
          </p>

          <% if user_signed_in? %>

            <%= form_with url: checkout_bookings_path(locale: I18n.locale), method: :post, local: true, id: "checkoutForm" do %>

              <input type="hidden" name="screening_id" value="<%= @screening.id %>">
              <input type="hidden" name="selected_seats" id="selectedSeatsInput" value="[]">

              <div class="checkout-email-row">
                <label><%= t("booking.email_for_tickets") %></label>

                <input
                  type="email"
                  value="<%= current_user.email %>"
                  readonly
                  class="checkout-email"
                >
              </div>

              <p class="checkout-hint">
                <%= t("booking.tickets_email_hint") %>
              </p>

              <button type="submit" class="checkout-pay-btn">
                <%= t("booking.pay") %>
                <span id="modalTotalPrice">0</span>
                <%= t("booking.currency") %>
              </button>

            <% end %>

          <% else %>

            <p class="checkout-hint">
              <%= t("booking.need_account") %>
            </p>

            <%= link_to t("booking.register"),
              new_user_registration_path(return_to: request.fullpath),
              class: "checkout-pay-btn" %>

          <% end %>

        </div>
      </div>

    </aside>

  </div>

</div>

<script>
  const rowText = "<%= t('booking.row') %>"
  const seatText = "<%= t('booking.seat') %>"
  const emptyOrderText = "<%= t('booking.empty_order') %>"
  const currencyText = "<%= t('booking.currency') %>"

  function updateOrder() {
    const selectedSeats = document.querySelectorAll(".seat.selected")
    const list = document.getElementById("selectedSeatsList")
    const totalPrice = document.getElementById("totalPrice")
    const modalTotal = document.getElementById("modalTotalPrice")
    const selectedSeatsInput = document.getElementById("selectedSeatsInput")

    let total = 0
    let seatsData = []

    list.innerHTML = ""

    if (selectedSeats.length === 0) {
      list.innerHTML = `<p class="empty-order">${emptyOrderText}</p>`
      totalPrice.textContent = "0"

      if (modalTotal) modalTotal.textContent = "0"
      if (selectedSeatsInput) selectedSeatsInput.value = "[]"

      return
    }

    selectedSeats.forEach(selected => {
      const row = selected.dataset.row
      const seatNumber = selected.dataset.seat
      const price = Number(selected.dataset.price)

      total += price

      seatsData.push({
        row: row,
        seat: seatNumber,
        price: price
      })

      list.innerHTML += `
        <div class="selected-seat-item">
          <span>${rowText} ${row}, ${seatText} ${seatNumber}</span>
          <strong>${price} ${currencyText}</strong>
        </div>
      `
    })

    totalPrice.textContent = total

    if (modalTotal) modalTotal.textContent = total
    if (selectedSeatsInput) selectedSeatsInput.value = JSON.stringify(seatsData)
  }

  document.addEventListener("click", function(event) {
    const seat = event.target.closest(".seat")

    if (seat && !seat.classList.contains("booked")) {
      seat.classList.toggle("selected")
      updateOrder()
    }

    if (event.target.closest("#openCheckoutModal")) {
      const selectedSeats = document.querySelectorAll(".seat.selected")

      if (selectedSeats.length === 0) {
        alert(emptyOrderText)
        return
      }

      document.getElementById("checkoutModal").classList.add("active")
    }

    if (
      event.target.closest("#closeCheckoutModal") ||
      event.target.closest("#checkoutCloseBtn")
    ) {
      document.getElementById("checkoutModal").classList.remove("active")
    }
  })
</script>